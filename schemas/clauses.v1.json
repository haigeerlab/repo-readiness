{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haigeerlab/repo-readiness/schemas/clauses.v1.json",
  "title": "repo-readiness clause file v1",
  "description": "A ruler: tiers, gate rules and clauses. kind=base is a full ruler; kind=stack adds clauses for one technology stack on top of a base (composition lands in a later release). See docs/spec/SPEC.md section 3.1.",
  "type": "object",
  "required": ["schema", "id", "version", "kind", "owner", "clauses"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "repo-readiness.clauses/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "version": { "$ref": "#/$defs/semver" },
    "kind": { "enum": ["base", "stack"] },
    "owner": { "type": "string", "minLength": 1, "description": "Who owns the content of this ruler (a mailbox name)" },
    "title": { "type": "string" },
    "stack": { "type": "string", "pattern": "^[A-Z]{2,3}$", "description": "kind=stack only: stack code, e.g. FE, SH" },
    "detect": { "$ref": "#/$defs/detect" },
    "categories": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "rank"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "rank": { "type": "integer", "minimum": 1 },
          "trust_cap": { "type": "string", "description": "Copied verbatim into conclusions; the tool never interprets it" },
          "should": { "$ref": "#/$defs/should_rule", "description": "Overrides gate.should for this tier" }
        }
      }
    },
    "below_lowest": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "trust_cap": { "type": "string" }
      }
    },
    "gate": {
      "type": "object",
      "required": ["should"],
      "additionalProperties": false,
      "properties": {
        "cumulative": { "const": true, "description": "Reaching a tier requires every lower tier too" },
        "must": { "const": "all" },
        "should": { "$ref": "#/$defs/should_rule" },
        "na_majority": { "enum": ["not-reached", "ignore"], "default": "not-reached", "description": "When more than half of a tier's must clauses are n/a" },
        "unknown": { "const": "counts-as-gap" }
      }
    },
    "waiver": {
      "type": "object",
      "required": ["max_days"],
      "additionalProperties": false,
      "properties": {
        "max_days": { "type": "integer", "minimum": 1 },
        "non_waivable": { "type": "array", "items": { "$ref": "#/$defs/clause_id" }, "uniqueItems": true }
      }
    },
    "app_aggregation": { "const": "min" },
    "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "base" } } },
      "then": { "required": ["tiers", "below_lowest", "gate"] }
    },
    {
      "if": { "properties": { "kind": { "const": "stack" } } },
      "then": {
        "required": ["stack"],
        "properties": { "tiers": false, "below_lowest": false, "gate": false, "waiver": false, "app_aggregation": false }
      }
    }
  ],
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$" },
    "clause_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(-[A-Z0-9]+)*$" },
    "should_rule": {
      "oneOf": [
        {
          "type": "object",
          "required": ["rule", "ratio"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "ratio" },
            "ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "rounding": { "enum": ["floor", "ceil"], "default": "floor" }
          }
        },
        {
          "type": "object",
          "required": ["rule", "max_missing"],
          "additionalProperties": false,
          "properties": {
            "rule": { "const": "max_missing" },
            "max_missing": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "any_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "all_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "none_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "probe": {
      "oneOf": [
        {
          "type": "object",
          "required": ["use"],
          "additionalProperties": false,
          "properties": {
            "use": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
            "with": { "type": "object" },
            "then": { "$ref": "#/$defs/probe", "description": "Runs after this probe; used to hand deterministic evidence to an agent judgment" }
          }
        },
        {
          "type": "object",
          "required": ["all"],
          "additionalProperties": false,
          "properties": { "all": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probe" } } }
        },
        {
          "type": "object",
          "required": ["any"],
          "additionalProperties": false,
          "properties": { "any": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/probe" } } }
        }
      ]
    },
    "clause": {
      "type": "object",
      "required": ["id", "requirement", "guards", "levels", "scope", "applies", "method", "probe"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/clause_id" },
        "layer": { "type": "string" },
        "requirement": { "type": "string", "minLength": 1 },
        "guards": { "type": "string", "minLength": 1, "description": "The failure this clause prevents" },
        "rationale": { "type": "string" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["tier", "strength"],
            "additionalProperties": false,
            "properties": {
              "tier": { "type": "string" },
              "strength": { "enum": ["must", "should"] }
            }
          }
        },
        "scope": { "enum": ["repo", "app"] },
        "applies": {
          "type": "object",
          "required": ["categories"],
          "additionalProperties": false,
          "properties": {
            "categories": {
              "oneOf": [
                { "const": "*" },
                { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
              ]
            },
            "when": { "$ref": "#/$defs/probe", "description": "Applies only when this probe is met (e.g. has third-party dependencies); otherwise n/a" }
          }
        },
        "method": { "enum": ["auto", "interface", "declare"] },
        "probe": { "$ref": "#/$defs/probe" },
        "remedy": {
          "type": "object",
          "required": ["class", "hint"],
          "additionalProperties": false,
          "properties": {
            "class": { "enum": ["auto", "confirm", "manual"] },
            "generator": { "type": "string" },
            "hint": { "type": "string", "minLength": 1 },
            "refs": { "type": "array", "items": { "type": "string" } }
          }
        },
        "na_allowed": { "type": "boolean", "default": true },
        "na_justification_required": { "type": "boolean", "default": true },
        "since": { "$ref": "#/$defs/semver" },
        "enforce_from": { "type": "string", "format": "date" },
        "lifecycle": { "enum": ["active", "future", "obsolete"], "default": "active" }
      }
    }
  }
}
