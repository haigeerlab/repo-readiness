{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/haigeerlab/autopr/schemas/entry-report.v1.json",
  "title": "autopr entry report v1",
  "description": "Report written by every autopr interface entry (check, setup, verify, suppressions, smoke) to $AUTOPR_REPORT. See interface-contract.md.",
  "type": "object",
  "required": ["schema", "entry", "repo", "head", "status", "exit_code", "started_at", "duration_s"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "autopr.entry-report/v1" },
    "entry": { "enum": ["check", "setup", "verify", "suppressions", "smoke"] },
    "mode": { "enum": ["full", "changed"], "default": "full", "description": "check only: full run or --changed fast path" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "app": { "type": "string", "description": "App id from interface.yml apps:, only for app-scoped entries" },
    "head": { "$ref": "#/$defs/sha" },
    "base": { "$ref": "#/$defs/sha" },
    "status": { "enum": ["pass", "fail", "error", "skipped"] },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 },
    "started_at": { "type": "string", "format": "date-time" },
    "duration_s": { "type": "number", "minimum": 0 },
    "producer": { "enum": ["native", "wrapped"], "description": "native = written by the entry itself; wrapped = generated by autopr-entry from the exit code" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail", "error", "skipped"] },
          "duration_s": { "type": "number", "minimum": 0 },
          "message": { "type": "string" },
          "enforces": { "type": "array", "items": { "type": "string" }, "description": "Rule ids from the repo's rule-to-enforcer table (clause K2)" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "message"],
        "additionalProperties": false,
        "properties": {
          "rule": { "type": "string" },
          "message": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "severity": { "enum": ["error", "warning", "info"] }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "artifacts"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "status": { "enum": ["pass", "fail", "error", "skipped"] },
          "artifacts": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Paths that also appear in artifacts[]" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "kind", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "description": "Relative to $AUTOPR_EVIDENCE_DIR; no '..'", "pattern": "^(?!/)(?!.*\\.\\.)" },
          "kind": { "enum": ["log", "screenshot", "video", "trace", "rendered-page", "json", "other"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "suppressions": {
      "type": "object",
      "required": ["total", "baseline", "by_kind", "new", "expired"],
      "additionalProperties": false,
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "baseline": { "type": "integer", "minimum": 0 },
        "by_kind": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } },
        "new": { "type": "array", "items": { "$ref": "#/$defs/suppression" } },
        "expired": { "type": "array", "items": { "$ref": "#/$defs/suppression" } }
      }
    },
    "environment": {
      "type": "object",
      "properties": {
        "offline": { "type": "boolean" },
        "network": { "enum": ["none", "required"] },
        "tools": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "pass" } } }, "then": { "properties": { "exit_code": { "const": 0 } } } },
    { "if": { "properties": { "status": { "const": "fail" } } }, "then": { "properties": { "exit_code": { "const": 1 } } } },
    { "if": { "properties": { "status": { "const": "error" } } }, "then": { "properties": { "exit_code": { "not": { "enum": [0, 1] } } } } },
    { "if": { "properties": { "entry": { "enum": ["verify", "smoke"] }, "status": { "const": "pass" } } }, "then": { "required": ["scenarios", "artifacts"], "properties": { "scenarios": { "minItems": 1 }, "artifacts": { "minItems": 1 } } } },
    { "if": { "properties": { "entry": { "const": "suppressions" }, "status": { "enum": ["pass", "fail"] } } }, "then": { "required": ["suppressions"] } }
  ],
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "suppression": {
      "type": "object",
      "required": ["file", "line", "kind"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string" },
        "line": { "type": "integer", "minimum": 1 },
        "kind": { "type": "string" },
        "allow": {
          "type": "object",
          "required": ["reason", "until", "approved_by"],
          "properties": {
            "reason": { "type": "string" },
            "until": { "type": "string", "format": "date" },
            "approved_by": { "type": "string" }
          }
        }
      }
    }
  }
}
